# Copy this file to .env and fill in configuration keys if needed
# Live Weather & Geocoding use Open-Meteo API (No API key required)

# Optional market API key for data.gov.in Agmarknet API
MARKET_API_URL=
MARKET_API_KEY=

# Optional configuration overrides
WEATHER_CACHE_TTL=600
WEIGHT_MODEL=0.35
WEIGHT_SOIL=0.20
WEIGHT_WEATHER=0.15
WEIGHT_SEASON=0.05
WEIGHT_PROFIT=0.15
WEIGHT_RISK=0.10
